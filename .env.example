# RegPulse Configuration Environment Variables

# Google Gemini API key. If omitted or set to 'mock_api_key',
# the application will run in Mock Mode with deterministic results.
GEMINI_API_KEY=mock_api_key

# The Gemini model to use for semantic diffing and rule mapping.
# Recommended: gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash

# Database connection URL. RegPulse automatically initializes 
# and runs migrations on SQLite.
DATABASE_URL=sqlite:///./regpulse.db

# Logging level. Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
