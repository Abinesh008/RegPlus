# RegPulse Configuration Environment Variables

# Google Gemini API key.
# Replace with your own key in your local .env file.
# Example:
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use for semantic diffing and rule mapping.
# Recommended: gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash

# Database connection URL.
# RegPulse automatically initializes and runs migrations on SQLite.
DATABASE_URL=sqlite:///./regpulse.db

# Logging level.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO